---
import { profile } from '../data/profile';

// Keep your name connected to the profile on the landing page.
// Replace the sample bio, projects, tags, and notes below with your own.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const about = 'I’m a curious maker exploring the space between design and code. I like turning complex ideas into simple, thoughtful experiences — and learning something new along the way.';
const interests = ['Web development', 'Interface design', 'Creative coding'];
const currentProjects = [
  {
    title: 'Interface experiments',
    category: 'EXPLORATION / 01',
    description: 'A playground for small interactions, expressive layouts, and ideas that deserve a little more exploration.',
    tags: ['UI exploration', 'Prototyping'],
    visual: 'interface',
    notes: 'Sample project: use this space to explain what you are exploring, your role, and what you plan to build next.',
  },
  {
    title: 'A space of my own',
    category: 'PERSONAL WEBSITE / 02',
    description: 'Building a home for my projects and process. A simple starting point, with plenty of room to grow.',
    tags: ['Astro', 'TypeScript', 'CSS'],
    visual: 'website',
    notes: 'Sample project: describe your portfolio’s goals, the design choices you are testing, and what is coming next.',
  },
];
const pastProjects = [
  { title: 'A simpler daily planner', category: 'Web application', tags: 'Design / Development', description: 'Sample project: introduce the problem, describe your contribution, and share what you learned. Replace this with a real project when you are ready.' },
  { title: 'A small design system', category: 'Component collection', tags: 'Components / UI', description: 'Sample project: describe how you organized the typography, colors, and reusable components. Add screenshots or a live link here later.' },
  { title: 'An interactive data story', category: 'Creative exploration', tags: 'Data / Interaction', description: 'Sample project: explain the data or idea you explored and the experience you built around it. Keep the description short and concrete.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name} — about me, current projects, and past work.`} />
    <meta name="theme-color" content="#f7f8f8" />
    <title>{profile.name} | Portfolio</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-frame" aria-hidden="true"></div>
    <header class="site-header">
      <div class="header-inner">
        <a class="identity" href={`${base}/`} aria-label={`${profile.name}: back to link page`}>
          <span class="brand-mark" aria-hidden="true">↗</span>
          <span>{profile.name}<span class="identity-sub"> / PORTFOLIO</span></span>
        </a>
        <nav aria-label="Portfolio sections">
          <a href="#about">About</a>
          <a href="#current">Current</a>
          <a href="#past">Past work</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="about section" id="about" aria-labelledby="about-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="section-number">01</span> ABOUT ME <span class="line"></span></p>
          <h1 id="about-title">Thoughtful ideas.<br /><span class="muted">Useful things.</span><span class="orange">*</span></h1>
          <p class="intro">Hi, I’m <strong>{profile.name}.</strong></p>
          <p class="bio">{about}</p>
          <ul class="interests" aria-label="Areas of interest">
            {interests.map((interest) => <li>{interest}</li>)}
          </ul>
          <a class="primary-link" href="#current">Explore my work <span aria-hidden="true">↗</span></a>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="art-top"><span>AN IDEA TAKING SHAPE</span><span>+ +</span></div>
          <svg class="orbital" viewBox="0 0 440 370" fill="none">
            <defs>
              <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="0.8" fill="#b6c8c8" /></pattern>
              <linearGradient id="face" x1="185" y1="139" x2="245" y2="237" gradientUnits="userSpaceOnUse"><stop stop-color="#ffad7c"/><stop offset="1" stop-color="#f46c2f"/></linearGradient>
            </defs>
            <rect width="440" height="370" fill="url(#dots)" />
            <path d="M0 185H440M220 0V370" stroke="#dde5e5" stroke-dasharray="3 7" />
            <circle cx="220" cy="185" r="136" stroke="#cddada" />
            <circle cx="220" cy="185" r="111" stroke="#e1e9e9" />
            <ellipse cx="220" cy="185" rx="181" ry="62" transform="rotate(-32 220 185)" stroke="#00bdba" stroke-width="1.4" />
            <ellipse cx="220" cy="185" rx="171" ry="74" transform="rotate(48 220 185)" stroke="#00bdba" stroke-width="1.2" />
            <path d="M220 122 276 153 220 187 164 155Z" fill="#ffc6a6" stroke="#f26a2c" />
            <path d="M164 155 220 187V250L164 217Z" fill="url(#face)" stroke="#f26a2c" />
            <path d="M220 187 276 153V217L220 250Z" fill="#ed6126" stroke="#e15a23" />
            <circle cx="71" cy="273" r="5" fill="#00aaa7" />
            <circle cx="333" cy="318" r="4" fill="#f4783c" />
            <path d="M334 52h12m-6-6v12M91 83h12m-6-6v12" stroke="#709292" />
            <path d="M20 32V20H32M408 20H420V32M20 338V350H32M408 350H420V338" stroke="#00bcb8" />
          </svg>
          <div class="art-bottom"><span><i></i> ALWAYS IN PROGRESS</span><span>FIG. 001</span></div>
        </div>
      </section>

      <section class="section projects-section" id="current" aria-labelledby="current-title">
        <div class="section-heading">
          <div><p class="eyebrow"><span class="section-number">02</span> IN THE MAKING</p><h2 id="current-title">Current projects<span class="orange">.</span></h2></div>
          <p>A few ideas on the workbench.<br /><span class="sample-note">Sample content for this prototype.</span></p>
        </div>
        <div class="project-grid">
          {currentProjects.map((project) => (
            <article class="project-card">
              <div class:list={['project-visual', project.visual]} aria-hidden="true">
                <span class="visual-index">{project.category}</span>
                {project.visual === 'interface' ? (
                  <div class="mock-dashboard">
                    <div class="mock-sidebar"><span class="mock-logo"></span><i></i><i></i><i></i><i></i></div>
                    <div class="mock-content"><div class="mock-heading"><b>Overview</b><span>THIS WEEK ↗</span></div><div class="mock-stats"><div><i></i><b>128<span> +18%</span></b></div><div><i></i><b>84<span> +12%</span></b></div></div><div class="mock-chart"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div></div>
                  </div>
                ) : (
                  <div class="mock-browser"><div class="browser-bar"><span>• • •</span><span>my little corner of the internet</span><span>↗</span></div><div class="mock-page"><div class="mini-avatar">✳</div><b>Hello, world<span>.</span></b><p>A place for ideas to live.</p><div class="mini-button">Selected work <span>↗</span></div><div class="mini-button outline">A little about me <span>↗</span></div></div></div>
                )}
                <span class="visual-cross">+</span>
              </div>
              <div class="card-body"><div class="card-status"><span></span> IN PROGRESS</div><h3>{project.title}</h3><p>{project.description}</p><ul class="tags" aria-label="Project topics">{project.tags.map((tag) => <li>{tag}</li>)}</ul><details class="project-notes"><summary>Project notes <span class="details-icon" aria-hidden="true">+</span></summary><p>{project.notes}</p></details></div>
            </article>
          ))}
        </div>
      </section>

      <section class="section past-section" id="past" aria-labelledby="past-title">
        <div class="section-heading"><div><p class="eyebrow"><span class="section-number">03</span> THE ARCHIVE</p><h2 id="past-title">Past projects<span class="orange">.</span></h2></div><p>Experiments, lessons, and finished things.<br /><span class="sample-note">Example entries — make these your own.</span></p></div>
        <div class="archive">
          {pastProjects.map((project, index) => (
            <details class="archive-item"><summary><span class="archive-number">0{index + 1}</span><span class="archive-name"><span class="archive-category">{project.category}</span><span class="archive-title">{project.title}</span></span><span class="archive-tags">{project.tags}</span><span class="details-icon" aria-hidden="true">+</span></summary><div class="archive-description"><p>{project.description}</p></div></details>
          ))}
        </div>
      </section>

      <footer class="site-footer"><div><span class="footer-spark" aria-hidden="true">✳</span><p>Still curious.<br /><strong>Always building.</strong></p></div><a href={`${base}/`}>Back to my links <span aria-hidden="true">↗</span></a><span class="footer-note">{profile.name} / PORTFOLIO</span></footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 108px; }
  :global(body) { position: relative; margin: 0; background: #f7f8f8; color: #202a30; font-family: 'Segoe UI', Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(::selection) { background: #b5eeea; color: #202a30; }
  :global(a) { color: inherit; }
  :global(a:focus-visible), :global(summary:focus-visible) { outline: 2px solid #b54c17; outline-offset: 6px; }
  .skip-link { position: fixed; top: 12px; left: 24px; z-index: 10; padding: 12px; background: white; transform: translateY(-200%); }
  .skip-link:focus { transform: translateY(0); }
  .page-frame { position: absolute; inset: 16px; border: 1px solid #22c5c033; pointer-events: none; z-index: 5; }
  .page-frame::before, .page-frame::after { content: ''; position: absolute; width: 70px; height: 70px; border-color: #00b9b3; border-style: solid; }
  .page-frame::before { left: -1px; top: -1px; border-width: 1px 0 0 1px; }
  .page-frame::after { right: -1px; bottom: -1px; border-width: 0 1px 1px 0; }
  .site-header { position: sticky; top: 0; z-index: 4; background: #f7f8f8f5; border-bottom: 1px solid #dce5e5; }
  .header-inner, main { width: min(1120px, calc(100% - 112px)); margin-inline: auto; }
  .header-inner { min-height: 94px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .identity { display: flex; align-items: center; gap: 12px; text-decoration: none; font-size: 14px; font-weight: 650; }
  .brand-mark { display: grid; place-items: center; width: 30px; height: 30px; background: #ee7337; color: #19272e; font-size: 23px; font-weight: 400; }
  .identity-sub { padding-left: 10px; color: #647277; font: 10px 'Courier New', monospace; letter-spacing: 1px; }
  nav { display: flex; gap: 30px; }
  nav a { text-decoration: none; font-size: 12px; padding: 8px 0; border-bottom: 1px solid transparent; }
  nav a:hover { border-color: #00a9a3; }
  .section { border-bottom: 1px solid #c8dddd; padding-block: 58px; }
  .about { display: grid; grid-template-columns: 1.25fr 1fr; gap: 46px; align-items: center; padding-block: 66px 64px; }
  .eyebrow { display: flex; align-items: center; gap: 14px; margin: 0 0 25px; color: #53666d; font: 10px 'Courier New', monospace; letter-spacing: 1.4px; }
  .section-number { color: #007e7b; }
  .line { display: inline-block; width: 55px; height: 1px; background: #00b9b3; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 24px; font-size: clamp(40px, 4.8vw, 63px); line-height: 1.08; letter-spacing: -3px; font-weight: 600; }
  .muted { color: #859294; }
  .orange { color: #e66a2c; }
  h1 .orange { margin-left: 4px; }
  .intro { font-size: 17px; margin-bottom: 12px; }
  .intro strong { font-weight: 600; }
  .bio { max-width: 475px; font-size: 14px; line-height: 1.8; color: #5b686e; margin-bottom: 21px; }
  .interests, .tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; list-style: none; }
  .interests li { color: #48615f; font-size: 10px; padding: 6px 9px; border: 1px solid #c9dedb; background: #eef5f3; }
  .primary-link { display: inline-flex; align-items: center; gap: 32px; margin-top: 29px; padding: 13px 18px; border: 1px solid #26353a; background: #26353a; color: white; font-size: 12px; text-decoration: none; transition: background 160ms; }
  .primary-link:hover { background: #176e6a; border-color: #176e6a; }
  .primary-link span { font-size: 19px; }
  .hero-art { border: 1px solid #d7e3e2; background: #f0f4f3; min-width: 0; }
  .art-top, .art-bottom { display: flex; justify-content: space-between; gap: 10px; align-items: center; padding: 16px; color: #53686b; font: 9px 'Courier New', monospace; letter-spacing: .6px; }
  .art-top { border-bottom: 1px solid #dce7e4; }
  .art-bottom { border-top: 1px solid #dce7e4; }
  .art-bottom span:first-child { display: flex; align-items: center; gap: 7px; }
  .art-bottom i { width: 5px; height: 5px; background: #00958e; border-radius: 50%; }
  .orbital { display: block; width: 100%; height: auto; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 28px; }
  .section-heading .eyebrow { margin-bottom: 12px; }
  h2 { font-size: 32px; line-height: 1.2; letter-spacing: -1.2px; font-weight: 550; margin: 0; }
  .section-heading > p { color: #5b686e; font-size: 12px; line-height: 1.8; margin: 0; }
  .sample-note { font-size: 10px; color: #66757a; }
  .project-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .project-card { min-width: 0; border: 1px solid #d8e1e1; background: #fff; }
  .project-visual { height: 250px; position: relative; overflow: hidden; display: flex; justify-content: center; align-items: flex-end; padding: 45px 34px 0; border-bottom: 1px solid #d8e1e1; }
  .interface { background: repeating-linear-gradient(0deg, transparent, transparent 27px, #b3cec52b 28px), repeating-linear-gradient(90deg, transparent, transparent 27px, #b3cec52b 28px), #eaf0ee; }
  .website { background: repeating-linear-gradient(0deg, transparent, transparent 27px, #ced3d52b 28px), repeating-linear-gradient(90deg, transparent, transparent 27px, #ced3d52b 28px), #eef0f1; }
  .visual-index { position: absolute; left: 18px; top: 16px; font: 9px 'Courier New', monospace; letter-spacing: 1px; color: #53666d; }
  .visual-cross { position: absolute; right: 15px; bottom: 12px; color: #007e7b; font: 20px 'Courier New', monospace; }
  .mock-dashboard { width: 100%; max-width: 375px; height: 181px; display: flex; background: white; border: 1px solid #cbd9d4; box-shadow: 0 10px 30px #2b504910; transform: translateY(8px) rotate(-3deg); }
  .mock-sidebar { width: 42px; flex-shrink: 0; border-right: 1px solid #e3e8e6; padding: 17px 12px; display: flex; flex-direction: column; gap: 15px; }
  .mock-logo { width: 14px; height: 14px; background: #00aaa4; margin-bottom: 4px; }
  .mock-sidebar i { width: 13px; height: 3px; background: #d5ddda; }
  .mock-content { padding: 20px; flex: 1; min-width: 0; }
  .mock-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 11px; }
  .mock-heading span { color: #687978; font: 5px 'Courier New', monospace; }
  .mock-stats { display: flex; gap: 10px; margin-top: 16px; }
  .mock-stats > div { background: #f4f7f5; flex: 1; padding: 8px; }
  .mock-stats i { display: block; width: 24px; height: 3px; background: #a6b6af; margin-bottom: 5px; }
  .mock-stats b { font-size: 16px; font-weight: 500; }
  .mock-stats b span { font-size: 7px; color: #16756f; }
  .mock-chart { display: flex; gap: 10px; align-items: end; height: 46px; margin-top: 12px; border-bottom: 1px solid #d4e2dc; }
  .mock-chart span { background: #9ed6ce; flex: 1; height: 40%; }
  .mock-chart span:nth-child(2n) { height: 65%; }
  .mock-chart span:nth-child(3n) { height: 85%; }
  .mock-chart span:last-child { height: 100%; background: #00a69f; }
  .mock-browser { max-width: 330px; width: 100%; height: 211px; background: #fff; border: 1px solid #cfd8dc; box-shadow: 0 10px 30px #30444910; transform: translateY(20px) rotate(3deg); }
  .browser-bar { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; border-bottom: 1px solid #e3e7e8; font: 6px 'Courier New', monospace; color: #66757a; }
  .browser-bar > span:first-child { color: #d78055; font-size: 10px; }
  .mock-page { width: 170px; margin: 15px auto; text-align: center; }
  .mini-avatar { display: grid; place-items: center; background: #f5e9df; width: 28px; height: 28px; border-radius: 50%; color: #ce5a25; margin: 0 auto 6px; }
  .mock-page > b { font-size: 17px; font-weight: 500; letter-spacing: -.5px; }
  .mock-page > b span { color: #d05f2b; }
  .mock-page p { font-size: 7px; color: #69757a; margin: 5px 0 12px; }
  .mini-button { display: flex; justify-content: space-between; background: #344646; padding: 8px 10px; color: white; font-size: 7px; margin-top: 5px; }
  .mini-button.outline { background: #f0f3f2; color: #344646; }
  .card-body { padding: 26px 26px 0; }
  .card-status { display: flex; align-items: center; gap: 7px; font: 9px 'Courier New', monospace; letter-spacing: .9px; color: #8e4c2d; margin-bottom: 13px; }
  .card-status > span { width: 5px; height: 5px; background: #df6a30; border-radius: 50%; }
  h3 { font-size: 23px; font-weight: 550; letter-spacing: -.5px; margin-bottom: 10px; }
  .card-body > p { font-size: 13px; line-height: 1.8; color: #5b686e; margin-bottom: 18px; }
  .tags { gap: 6px; margin-bottom: 24px; }
  .tags li { padding: 5px 8px; background: #f3f5f5; font-size: 10px; color: #53646c; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .project-notes { border-top: 1px solid #e1e7e7; }
  .project-notes summary { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; font-size: 12px; }
  .project-notes summary:hover { color: #007d78; }
  .details-icon { display: inline-block; flex-shrink: 0; color: #007f7b; font: 23px 'Courier New', monospace; transition: transform 160ms; }
  details[open] > summary .details-icon { transform: rotate(45deg); }
  .project-notes p, .archive-description p { color: #5b686e; font-size: 13px; line-height: 1.8; padding-bottom: 12px; margin: 0; }
  .past-section { padding-bottom: 58px; }
  .archive { border-top: 1px solid #d3dddd; }
  .archive-item { border-bottom: 1px solid #d3dddd; }
  .archive-item > summary { display: flex; align-items: center; gap: 24px; padding: 25px 8px; }
  .archive-item > summary:hover { background: #edf5f3; }
  .archive-number { color: #007e7b; font: 10px 'Courier New', monospace; }
  .archive-name { display: grid; gap: 7px; }
  .archive-category { color: #5d7077; font: 9px 'Courier New', monospace; text-transform: uppercase; letter-spacing: .6px; }
  .archive-title { font-size: 19px; font-weight: 500; letter-spacing: -.3px; }
  .archive-tags { margin-left: auto; margin-right: 36px; color: #5d7077; font-size: 11px; }
  .archive-item .details-icon { margin-left: auto; }
  .archive-description { padding: 0 44px 15px; max-width: 760px; }
  .site-footer { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; padding: 36px 0 46px; }
  .site-footer > div { display: flex; align-items: center; gap: 16px; }
  .footer-spark { color: #e66a2c; font-size: 38px; }
  .site-footer p { color: #68777a; font-size: 13px; line-height: 1.6; margin: 0; }
  .site-footer strong { color: #27363a; font-weight: 500; }
  .site-footer > a { margin-left: auto; text-decoration: none; font-size: 12px; border-bottom: 1px solid #00aaa4; padding-bottom: 6px; }
  .site-footer > a span { margin-left: 14px; color: #c55925; }
  .footer-note { width: 100%; padding-top: 15px; border-top: 1px solid #e0e7e7; color: #66767b; font: 9px 'Courier New', monospace; letter-spacing: 1px; }
  @media (min-width: 1600px) { .about { padding-block: 85px; } }
  @media (max-width: 900px) {
    .header-inner, main { width: calc(100% - 72px); }
    .identity-sub { display: none; }
    .about { gap: 24px; }
    h1 { font-size: 43px; letter-spacing: -2px; }
    .hero-art .art-top, .hero-art .art-bottom { font-size: 7px; padding: 12px; }
    .project-visual { padding-inline: 20px; height: 225px; }
    .card-body { padding-inline: 20px; }
    .archive-tags { margin-right: 12px; }
  }
  @media (max-width: 660px) {
    .page-frame { inset: 8px; }
    .page-frame::before, .page-frame::after { width: 35px; height: 35px; }
    .header-inner, main { width: calc(100% - 48px); }
    .header-inner { min-height: 92px; padding: 20px 0 12px; flex-wrap: wrap; gap: 14px; }
    .identity { font-size: 13px; }
    nav { width: 100%; justify-content: space-between; gap: 12px; }
    nav a { font-size: 11px; }
    :global(html) { scroll-padding-top: 140px; }
    .about { grid-template-columns: 1fr; gap: 32px; padding-block: 40px; }
    h1 { font-size: clamp(34px, 9vw, 51px); letter-spacing: -1.8px; }
    .hero-art { max-width: 420px; width: 100%; margin-inline: auto; }
    .orbital { max-height: 290px; }
    .hero-art .art-top, .hero-art .art-bottom { font-size: 8px; }
    .section { padding-block: 40px; }
    .section-heading { align-items: start; flex-direction: column; gap: 14px; }
    h2 { font-size: 29px; }
    .project-grid { grid-template-columns: 1fr; }
    .project-visual { height: 230px; }
    .archive-item > summary { gap: 14px; padding-block: 24px; }
    .archive-title { font-size: 17px; }
    .archive-tags { display: none; }
    .archive-description { padding-inline: 34px 12px; }
    .site-footer { padding-bottom: 30px; gap: 24px; }
    .site-footer > a { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .primary-link, .details-icon { transition: none; }
  }
</style>
