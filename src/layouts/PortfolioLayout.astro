---
import { profile } from '../data/profile';
import Header from '../components/portfolio/Header.astro';
import Footer from '../components/portfolio/Footer.astro';
import '../styles/portfolio.css';
interface Props { title: string; description: string; image?: string; sample?: boolean; }
const { title, description, image, sample = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = Astro.site && image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f8" />
    <title>{title} | {profile.name}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {sample && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${profile.name}`} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-frame" aria-hidden="true"></div>
    <Header />
    <main id="main"><slot /><Footer /></main>
  </body>
</html>
