---
import { profile } from '../../data/profile';
import { withBase } from '../../lib/portfolio';
---
<header class="site-header">
  <div class="header-inner">
    <a class="identity" href={withBase()} aria-label={`${profile.name}: back to link page`}>
      <span class="brand-mark" aria-hidden="true">↗</span>
      <span>{profile.name}<span class="identity-sub"> / PORTFOLIO</span></span>
    </a>
    <nav aria-label="Portfolio navigation">
      <a href={withBase('projects/#about')}>About</a>
      <a href={withBase('projects/#current')}>Projects</a>
      <a href={withBase()}>My links <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
